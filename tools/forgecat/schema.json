{
  "categories": {
    "moves": {
      "id_prefix": "move",
      "required_fields": ["nom", "tiers", "type", "effets"]
    },
    "abilities": {
      "id_prefix": "ability",
      "required_fields": ["nom", "tiers", "effets"]
    },
    "equipment": {
      "id_prefix": "equipment",
      "required_fields": ["nom", "tiers", "effets"]
    },
    "items": {
      "id_prefix": "item",
      "required_fields": ["nom", "tiers", "effets"]
    },
    "status": {
      "id_prefix": "status",
      "required_fields": ["nom", "incompatibilités", "effets"]
    }
  },
  "fields": {
    "nom": { "type": "text" },
    "tiers": { "type": "int" },
    "type": {
      "type": "enum",
      "values": ["feu", "eau", "plante", "électrique", "vol", "sol", "normal", "combat", "insecte", "glace", "fée", "spectre", "ténèbres", "acier", "dragon", "psy", "poison"]
    },
    "évolutif": {
      "type": "enum",
      "values": ["oui", "non"]
    },
    "prérequis": { "type": "text" },
    "portée": {
      "type": "enum",
      "values": ["contact", "courte", "moyenne", "longue"]
    },
    "cible": {
      "type": "enum",
      "values": ["personnelle", "une cible"]
    },
    "utilisation": {
      "type": "enum",
      "values": ["action", "réaction", "action rapide"]
    },
    "concentration": {
      "type": "enum",
      "values": ["oui", "non"]
    },
    "effets": { "type": "text" },
    "incompatibilités": { "type": "list" }
  }
}
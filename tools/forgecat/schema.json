{
  "categories": {
    "moves": {
      "id_prefix": "move",
      "required_fields": ["nom", "tiers", "type", "effets"]
    },
    "abilities": {
      "id_prefix": "ability",
      "required_fields": ["nom", "tiers", "effets"]
    },
    "equipment": {
      "id_prefix": "equipment",
      "required_fields": ["nom", "tiers", "effets"]
    },
    "items": {
      "id_prefix": "item",
      "required_fields": ["nom", "tiers", "effets"]
    },
    "status": {
      "id_prefix": "status",
      "required_fields": ["nom", "incompatibilités", "effets"]
    }
  },
  "fields": {
    "nom": { "type": "text" },
    "tiers": { "type": "int" },
    "type": {
      "type": "enum",
      "values": ["feu", "eau", "plante", "électrique", "vol", "sol", "normal", "combat", "insecte", "glace", "fée", "spectre", "ténèbres", "acier", "dragon", "psy", "poison"]
    },
    "évolutif": {
      "type": "enum",
      "values": ["oui", "non"]
    },
    "contact": {
      "type": "enum",
      "values": ["oui", "non"]
    },
    "prérequis": { "type": "text" },
    "conditions": { "type": "text" },
    "portée": {
      "type": "enum",
      "values": ["voir description", "personnelle", "contact", "courte", "moyenne", "longue"]
    },
    "envergure": {
      "type": "enum",
      "values": ["voir description", "contact", "courte", "moyenne", "longue"]
    },
    "cible": {
      "type": "enum",
      "values": ["voir description", "aucune", "personnelle", "une cible", "une cible ou personnelle", "multicibles", "une ligne", "un cône", "une zone"]
    },
    "utilisation": {
      "type": "enum",
      "values": ["voir description", "action", "réaction", "action rapide"]
    },
    "jet de sauvegarde": {
      "type": "enum",
      "values": ["voir description", "force", "charisme", "constitution", "esprit", "agilité"]
    },
    "taux de critique": { "type": "int" },
    "taux de maladresse": { "type": "int" },
    "mouvement minimal": {
      "type": "enum",
      "values": ["voir description", "courte", "moyenne", "longue"]
    },
    "mouvement offert": {
      "type": "enum",
      "values": ["voir description", "courte", "moyenne", "longue"]
    },
    "mécaniques": { "type": "text" },
    "tags": { "type": "text" },
    "effets": { "type": "text" },
    "incompatibilités": { "type": "list" }
  }
}